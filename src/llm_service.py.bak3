"""
LLM service for generating responses in the Legal RAG system using OpenAI.
"""
from typing import List, Dict, Any
from langchain_community.llms import OpenAI
from langchain_classic.chains import RetrievalQA
from langchain_classic.prompts import PromptTemplate
from langchain_core.documents import Document
import os
from dotenv import load_dotenv

# Load environment variables
load_dotenv()


class LegalLLMService:
    """Service for handling LLM operations in the legal RAG system using OpenAI."""
    
    def __init__(self, 
                 model_name: str = "gpt-3.5-turbo",
                 temperature: float = 0.1,
                 max_tokens: int = 1000):
        """
        Initialize the LLM service with OpenAI.
        
        Args:
            model_name: Name of the OpenAI model to use
            temperature: Temperature for sampling (0.0 = deterministic)
            max_tokens: Maximum tokens in generated response
        """
        self.model_name = model_name
        self.temperature = temperature
        self.max_tokens = max_tokens
        
        # Get API key from environment
        api_key = os.getenv("OPENAI_API_KEY")
        if not api_key:
            raise ValueError("OPENAI_API_KEY environment variable is required")
        
        # Initialize the OpenAI LLM
        self.llm = OpenAI(
            openai_api_key=api_key,
            model_name=model_name,
            temperature=temperature,
            max_tokens=max_tokens
        )
        
        # Create prompt template for legal QA
        self.qa_prompt = PromptTemplate(
            template="""You are a legal assistant specialized in analyzing legal documents. 
            Use the following pieces of context to answer the user's question. 
            If you don't know the answer based on the context, say you don't know - 
            don't try to make up an answer.
            
            Context: {context}
            
            Question: {question}
            
            Answer: Provide a clear, concise answer based on the legal context provided.
            If referencing specific laws, cases, or regulations, cite them appropriately.
            Be precise and professional in your legal analysis.
            """,
            input_variables=["context", "question"]
        )
    
    def create_qa_chain(self, vectorstore):
        """
        Create a RetrievalQA chain for answering questions.
        
        Args:
            vectorstore: The vector store to use for retrieval
            
        Returns:
            RetrievalQA chain
        """
        qa_chain = RetrievalQA.from_chain_type(
            llm=self.llm,
            chain_type="stuff",
            retriever=vectorstore.as_retriever(search_kwargs={"k": 5}),
            chain_type_kwargs={"prompt": self.qa_prompt},
            return_source_documents=True
        )
        return qa_chain
    
    def generate_response(self, 
                         query: str, 
                         relevant_docs: List[Document]) -> Dict[str, Any]:
        """
        Generate a response based on query and relevant documents.
        
        Args:
            query: User's question
            relevant_docs: List of relevant documents from vector store
            
        Returns:
            Dictionary with answer and metadata
        """
        if not relevant_docs:
            return {
                "answer": "I don't have enough information in my knowledge base to answer that question.",
                "sources": [],
                "confidence": 0.0
            }
        
        # Format context from relevant documents
        context = "\n\n".join([doc.page_content for doc in relevant_docs])
        
        # Create prompt
        prompt = self.qa_prompt.format(context=context, question=query)
        
        try:
            # Generate response using OpenAI
            result = self.llm(prompt)
            answer = result.strip()
            
            # Extract sources
            sources = []
            for doc in relevant_docs:
                source_info = {
                    "content": doc.page_content[:200] + "..." if len(doc.page_content) > 200 else doc.page_content,
                    "metadata": doc.metadata
                }
                sources.append(source_info)
            
            return {
                "answer": answer,
                "sources": sources,
                "confidence": 0.85  # Higher confidence with OpenAI
            }
            
        except Exception as e:
            print(f"Error generating response: {e}")
            return {
                "answer": "I encountered an error while generating a response. Please try again.",
                "sources": [],
                "confidence": 0.0
            }